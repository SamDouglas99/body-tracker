rules_version = '2';
// Regras de segurança do Storage — Body Tracker (fotos de progresso)
// Cole em: Firebase Console → Storage → Regras → Publicar.
service firebase.storage {
  match /b/{bucket}/o {
    // Cada usuário só acessa as próprias fotos: photos/{uid}/...
    match /photos/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Qualquer outra coisa: negado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
